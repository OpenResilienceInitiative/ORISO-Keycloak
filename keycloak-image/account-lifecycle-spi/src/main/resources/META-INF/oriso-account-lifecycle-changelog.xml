<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
  <changeSet id="oriso-account-lifecycle-v1" author="oriso">
    <createTable tableName="ORISO_ACCOUNT_LIFECYCLE_ATTEMPT">
      <column name="ID" type="VARCHAR(255)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="REALM_ID" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="ATTEMPT_ID" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="OWNER_CLIENT" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="OWNER_SUBJECT" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="SCOPE_JSON" type="TEXT"><constraints nullable="false"/></column>
      <column name="GROUP_ID" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="ROLE_FINGERPRINT" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="CREATION_FINGERPRINT" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="CREATE_EXECUTION" type="VARCHAR(36)"></column>
      <column name="ACCOUNT_ID" type="VARCHAR(255)"><constraints unique="true"/></column>
      <column name="PROFILE_FINGERPRINT" type="VARCHAR(64)"></column>
      <column name="CREATION_PROOF" type="TEXT"></column>
      <column name="STATE" type="VARCHAR(30)"><constraints nullable="false"/></column>
      <column name="GENERATION" type="BIGINT"><constraints nullable="false"/></column>
      <column name="EXECUTION_ID" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="RECOVERY_ID" type="VARCHAR(36)"></column>
      <column name="RECOVERY_EXPECTED" type="BIGINT"></column>
      <column name="RECOVERY_DIGEST" type="VARCHAR(64)"></column>
      <column name="RECOVERY_RECEIPT" type="TEXT"></column>
      <column name="TERMINAL_OPERATION" type="VARCHAR(30)"></column>
      <column name="TERMINAL_DIGEST" type="VARCHAR(64)"></column>
      <column name="TERMINAL_RECEIPT" type="TEXT"></column>
      <column name="VERSION" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="ORISO_ACCOUNT_LIFECYCLE_ATTEMPT" baseColumnNames="REALM_ID" referencedTableName="REALM" referencedColumnNames="ID" constraintName="ORISO_ACCOUNT_LIFECYCLE_REALM" onDelete="CASCADE"/>
  </changeSet>
  <changeSet id="oriso-account-lifecycle-original-native-v1" author="oriso">
    <addColumn tableName="ORISO_ACCOUNT_LIFECYCLE_ATTEMPT">
      <column name="ORIGINAL_NATIVE_JSON" type="VARCHAR(512)"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
