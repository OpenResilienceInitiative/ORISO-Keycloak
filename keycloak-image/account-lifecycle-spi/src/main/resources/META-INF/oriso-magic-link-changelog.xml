<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
  <changeSet id="oriso-magic-link-session-v1" author="oriso">
    <createTable tableName="ORISO_MAGIC_LINK_SESSION">
      <column name="ID" type="VARCHAR(255)"><constraints primaryKey="true" nullable="false"/></column>
      <column name="REALM_ID" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="WORKFLOW_ID" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="TARGET_ID" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="CLIENT_ID" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="OWNER_CLIENT" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="OWNER_SUBJECT" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="COMMAND_DIGEST" type="VARCHAR(64)"><constraints nullable="false"/></column>
      <column name="NATIVE_SESSION_ID" type="VARCHAR(255)"><constraints nullable="false" unique="true"/></column>
      <column name="EXPIRES_AT" type="BIGINT"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="ORISO_MAGIC_LINK_SESSION" baseColumnNames="REALM_ID" referencedTableName="REALM" referencedColumnNames="ID" constraintName="ORISO_MAGIC_LINK_REALM" onDelete="CASCADE"/>
  </changeSet>
</databaseChangeLog>
